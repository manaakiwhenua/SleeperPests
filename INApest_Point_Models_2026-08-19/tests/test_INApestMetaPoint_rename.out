+   SpreadReduction=0, SpreadReductionSD=0,
+   DoProgress=FALSE, Seed=1
+ )
> stopifnot(inherits(fit, 'INApestMetaPoint'))
> stopifnot(inherits(fit, 'INApestPoint'))
