+.ina_branch_step_eval_no_detection_individual <- function(
+    step, qnext, mode = c("none", "all_informed", "dynamic")) {
+  mode <- match.arg(mode)
+  B <- length(step$q0)
+  q0 <- .ina_branch_clip(step$q0)
+  q1 <- .ina_branch_clip(step$q1)
+  a <- .ina_branch_clip(rep_len(as.numeric(step$adoption), B))
+  D <- .ina_branch_clip(rep_len(as.numeric(step$Detection), B))
+  if (length(D) != B) stop("Detection must be scalar or length B")
+
+  branch_value <- function(i, managed, parent_transform, recruit_transform) {
+    qs <- if (!managed) q0[i] else q1[i]
+    if (qs <= 0) return(1)
+    Pm <- if (!managed) step$Parent0[, i] else step$Parent1[, i]
+    Rm <- if (!managed) step$Recruit0[, i] else step$Recruit1[, i]
+    psum <- sum(Pm)
+    local <- 1 - psum / qs + sum((Pm / qs) * parent_transform)
+    mu <- Rm / qs
+    .ina_branch_clip((1 - qs) + qs * local * exp(sum(mu * (recruit_transform - 1))))
+  }
+
+  if (mode != "dynamic") {
+    q <- .ina_branch_clip(qnext)
+    if (length(q) != B) stop("qnext has wrong length for base branching step")
+    # Detection is an end-of-timestep event on every extant parent/recruit.
+    # Multiplication by (1-D) deletes all branches containing a detection.
+    qsilent <- (1 - D) * q
+    out <- numeric(B)
+    for (i in seq_len(B)) {
+      f0 <- branch_value(i, FALSE, qsilent, qsilent)
+      if (mode == "all_informed" && a[i] > 0) {
+        f1 <- branch_value(i, TRUE, qsilent, qsilent)
+        out[i] <- (1 - a[i]) * f0 + a[i] * f1
+      } else out[i] <- f0
+    }
+    return(.ina_branch_clip(out))
+  }
+
+  qnext <- .ina_branch_clip(qnext)
+  if (length(qnext) != 2L * B)
+    stop("qnext has wrong length for dynamic branching step")
+  qU <- qnext[seq_len(B)]
+  qH <- qnext[B + seq_len(B)]
+  IR <- .ina_branch_clip(rep_len(as.numeric(step$Retention), B))
+  C <- as.matrix(step$Transfer)
+  if (!all(dim(C) == c(B, B))) stop("Transfer must be B x B")
+  C[] <- pmin(1, pmax(0, C))
+
+  # Uninformed source: with detection forbidden, every surviving descendant
+  # must evade detection and therefore remains U unless informed by some other
+  # process (none applies to an uninformed source in the current branch step).
+  silentU <- (1 - D) * qU
+  outU <- numeric(B)
+  for (i in seq_len(B))
+    outU[i] <- branch_value(i, FALSE, silentU, silentU)
+
+  # Informed source: retained source information and direct SEAM can still make
+  # descendants H; the common (1-D) factor enforces surveillance silence.
+  outH <- numeric(B)
+  parentH <- (1 - D) * ((1 - IR) * qU + IR * qH)
+  for (i in seq_len(B)) {
+    hchild <- C[i, ]
+    recruitH <- (1 - D) * ((1 - hchild) * qU + hchild * qH)
+    f0 <- branch_value(i, FALSE, parentH, recruitH)
+    f1 <- branch_value(i, TRUE, parentH, recruitH)
+    outH[i] <- (1 - a[i]) * f0 + a[i] * f1
+  }
+  .ina_branch_clip(c(outU, outH))
+}
+
+.ina_branch_step_eval_no_detection_nodeshared <- function(step, qnext) {
+  B <- length(step$q0)
+  type_node <- as.integer(step$SharedInfoNode)
+  if (length(type_node) != B || any(!is.finite(type_node)) || any(type_node < 1L))
+    stop("SharedInfoNode must identify a positive node index for every base type")
+  nodes <- sort(unique(type_node))
+  qnext <- .ina_branch_clip(qnext)
+  if (length(qnext) != 2L * B)
+    stop("qnext has wrong length for dynamic branching step")
+  qU <- qnext[seq_len(B)]; qH <- qnext[B + seq_len(B)]
+  q0 <- .ina_branch_clip(step$q0); q1 <- .ina_branch_clip(step$q1)
+  a <- .ina_branch_clip(rep_len(as.numeric(step$adoption), B))
+  D <- .ina_branch_clip(rep_len(as.numeric(step$Detection), B))
+  IR <- .ina_branch_clip(rep_len(as.numeric(step$Retention), B))
+  C <- as.matrix(step$Transfer)
+  if (!all(dim(C) == c(B, B))) stop("Transfer must be B x B")
+  C[] <- pmin(1, pmax(0, C))
+
+  node_product <- function(i, managed, informed_source) {
+    qs <- if (!managed) q0[i] else q1[i]
+    if (qs <= 0) return(1)
+    Pm <- if (!managed) step$Parent0[, i] else step$Parent1[, i]
+    Rm <- if (!managed) step$Recruit0[, i] else step$Recruit1[, i]
+    ppar <- pmax(0, as.numeric(Pm) / qs)
+    mu <- pmax(0, as.numeric(Rm) / qs)
+    srcnode <- type_node[i]
+    parent_other <- which(ppar > 1e-14 & type_node != srcnode)
+    if (length(parent_other)) return(NA_real_)
+    pabs <- pmax(0, 1 - sum(ppar))
+
+    simple_node_gf <- function(types, x) {
+      rec <- exp(sum(mu[types] * (x - 1)))
+      if (type_node[i] == type_node[types[1L]]) {
+        par <- pabs + sum(ppar[types] * x)
+        rec * par
+      } else rec
+    }
+
+    ans <- 1
+    for (nd in nodes) {
+      types <- which(type_node == nd)
+      noU <- simple_node_gf(types, (1 - D[types]) * qU[types])
+      noH <- simple_node_gf(types, (1 - D[types]) * qH[types])
+      if (!informed_source) {
+        pinfo <- 0
+      } else if (nd == srcnode) {
+        pinfo <- IR[i]
+      } else {
+        pinfo <- C[i, types[1L]]
+      }
+      # Detection is forbidden. Existing/SEAM information can still select the
+      # H continuation, but there is no detection-created H branch.
+      ans <- ans * (pinfo * noH + (1 - pinfo) * noU)
+    }
+    .ina_branch_clip((1 - qs) + qs * ans)
+  }
+
+  outU <- outH <- numeric(B)
+  for (i in seq_len(B)) {
+    u <- node_product(i, FALSE, FALSE)
+    if (is.na(u)) return(NULL)
+    outU[i] <- u
+    h0 <- node_product(i, FALSE, TRUE)
+    h1 <- node_product(i, TRUE, TRUE)
+    if (is.na(h0) || is.na(h1)) return(NULL)
+    outH[i] <- (1 - a[i]) * h0 + a[i] * h1
+  }
+  .ina_branch_clip(c(outU, outH))
+}
+
+.ina_branch_step_eval_observation <- function(
+    step, qnext, mode = c("none", "all_informed", "dynamic"),
+    require_no_detection = FALSE) {
+  mode <- match.arg(mode)
+  if (!isTRUE(require_no_detection))
+    return(.ina_branch_step_eval(step, qnext, mode))
+  if (mode == "dynamic" && !is.null(step$SharedInfoNode)) {
+    z <- .ina_branch_step_eval_no_detection_nodeshared(step, qnext)
+    if (!is.null(z)) return(z)
+  }
+  .ina_branch_step_eval_no_detection_individual(step, qnext, mode)
+}
+
+.ina_branch_observation_horizon <- function(
+    steps, mode, no_detection_mask,
+    terminal = c("any", "extinct")) {
+  terminal <- match.arg(terminal)
+  if (!length(steps)) stop("steps must be non-empty")
+  if (length(no_detection_mask) != length(steps))
+    stop("no_detection_mask must match the number of branching steps")
+  B <- length(steps[[1L]]$q0)
+  nstate <- if (mode == "dynamic") 2L * B else B
+  q <- rep(if (terminal == "any") 1 else 0, nstate)
+  for (tt in rev(seq_along(steps)))
+    q <- .ina_branch_step_eval_observation(
+      steps[[tt]], q, mode,
+      require_no_detection = no_detection_mask[tt])
+  .ina_branch_clip(q)
+}
