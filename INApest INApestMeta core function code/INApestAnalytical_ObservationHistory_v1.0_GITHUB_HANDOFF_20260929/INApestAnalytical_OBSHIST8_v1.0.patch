+.ina_vertebrate_step_eval_observation <- function(step,qnext,D,require_no_detection=FALSE){q<-as.numeric(qnext);if(require_no_detection)q<-(1-D)*q;K<-length(q);out<-numeric(K);for(j in seq_len(K)){tp<-step$TransitionProb[[j]];pin<-sum(tp);pex<-step$TransitionExportProb[j];pother<-pmax(0,1-pin);existing<-pother+sum(tp*q);bm<-step$BirthMean[[j]];birth<-exp(sum(bm*(q-1)));out[j]<-.ina_branch_clip(existing*birth)};out}
+.ina_vertebrate_observation_horizon <- function(steps,Dsteps,mask,terminal=c("any","extinct")){terminal<-match.arg(terminal);K<-nrow(steps[[1]]$MeanOperator);q<-rep(if(terminal=="any")1 else 0,K);for(tt in rev(seq_along(steps)))q<-.ina_vertebrate_step_eval_observation(steps[[tt]],q,Dsteps[[tt]],mask[tt]);q}
+.ina_obshist_vertebrate <- function(args,Model,mask){
+  if(!is.null(.ina_obshist_get(args,"Vertebrate",NULL)) && any(vapply(c("Birth","HomeRange","Control","Interaction"),function(nm)!is.null(.ina_obshist_get(args,"Vertebrate",NULL)[[nm]]),logical(1)))) stop("ObservationHistory for specialist nonlinear vertebrate modules is not closed under independent-lineage branching; use stochastic conditioning or a group PGF")
+  T<-as.integer(.ina_obshist_get(args,"Ntimesteps",10)); Transition<-.ina_obshist_get(args,"Transition",required=TRUE); DetectionProb<-.ina_obshist_get(args,"DetectionProb",0)
+  if(Model=="INApestVertebrateNode"){X0<-as.matrix(.ina_obshist_get(args,"InitialState",required=TRUE));SDD<-.ina_obshist_get(args,"SDDprob",required=TRUE);LDD<-.ina_obshist_get(args,"LDDprob",NULL);LDDrate<-.ina_obshist_get(args,"LDDrate",0);TM<-.ina_obshist_get(args,"TransitionSDDprob",NULL);TML<-.ina_obshist_get(args,"TransitionLDDprob",NULL);TMLr<-.ina_obshist_get(args,"TransitionLDDrate",0)} else {ISC<-.ina_obshist_get(args,"InitialStageCounts",.ina_obshist_get(args,"InitialState",required=TRUE));SDD<-.ina_obshist_get(args,"ReproductiveMovement",.ina_obshist_get(args,"SDDprob",required=TRUE));nc<-nrow(as.matrix(SDD));S0<-.ina_obshist_get(args,"Nstages",if(is.matrix(ISC))ncol(ISC)else length(ISC));X0<-if(is.matrix(ISC))as.matrix(ISC) else {m<-matrix(0,nc,S0);m[1,]<-ISC;m};LDD<-NULL;LDDrate<-0;TM<-.ina_obshist_get(args,"TransitionMovement",NULL);TML<-NULL;TMLr<-0}
+  n<-nrow(X0);S<-ncol(X0);steps<-lapply(seq_len(T),function(tt).ivanal_animal_node_step(tt,T,S,Transition,n,SDD,LDD,LDDrate,TM,TML,TMLr,.ina_obshist_get(args,"PropaguleEstablishment",1),.ina_obshist_get(args,"EnvEstabProb",1),.ina_obshist_get(args,"MortalityProb",0),.ina_obshist_get(args,"ManagementExposure",.ina_obshist_get(args,"ManageProb",0)),.ina_obshist_get(args,"FecundityReduction",0),.ina_obshist_get(args,"OutsideEstablishmentProb",1)))
+  Dsteps<-lapply(seq_len(T),function(tt){z<-.ina_slice_stage(DetectionProb,tt,n,S,T,"DetectionProb");if(length(z)==1)rep(z,n*S)else if(length(z)==S)rep(z,n) else as.vector(t(as.matrix(z)))})
+  qC<-.ina_vertebrate_observation_horizon(steps,Dsteps,mask,"any");qJ<-.ina_vertebrate_observation_horizon(steps,Dsteps,mask,"extinct");x0<-as.vector(t(X0));c(P=.ina_overall_extinction(qC,x0),Joint=.ina_overall_extinction(qJ,x0))
+}
