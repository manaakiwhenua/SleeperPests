+      C <- if(is.null(SEAM)||length(SEAM)==1L) matrix(0,n,n) else as.matrix(SEAM); diag(C)<-0
+      steps[[tt]] <- list(P=P,s=.inapest_recycle(.ina_slice_node(Survival,tt,n,T,"Survival"),n,"Survival"),d=.inapest_recycle(.ina_slice_node(DetectionProb,tt,n,T,"DetectionProb"),n,"DetectionProb"),a=.inapest_recycle(.ina_slice_node(ManageProb,tt,n,T,"ManageProb"),n,"ManageProb"),e=.inapest_recycle(.ina_slice_node(EradicationProb,tt,n,T,"EradicationProb"),n,"EradicationProb"),r=.inapest_recycle(.ina_slice_node(SpreadReduction,tt,n,T,"SpreadReduction"),n,"SpreadReduction"),ir=.inapest_recycle(.ina_slice_node(InfoRetentionProb,tt,n,T,"InfoRetentionProb"),n,"InfoRetentionProb"),C=C)
+    }
+  } else if (Model=="INApestMeta") {
+    if(is.null(K)||is.null(PropaguleProduction)) stop("Meta ObservationHistory requires K and PropaguleProduction")
+    for(tt in seq_len(T)) steps[[tt]] <- .ina_meta_branch_step(.ina_slice_connection(SDDprob,tt,n,T,"SDDprob"),.ina_slice_connection(LDDprob,tt,n,T,"LDDprob"),LDDrate,.ina_slice_node(EnvEstabProb,tt,n,T,"EnvEstabProb"),.ina_slice_node(Survival,tt,n,T,"Survival"),.ina_slice_node(K,tt,n,T,"K"),.ina_slice_node(PropaguleProduction,tt,n,T,"PropaguleProduction"),.ina_slice_node(PropaguleEstablishment,tt,n,T,"PropaguleEstablishment"),.ina_slice_node(DetectionProb,tt,n,T,"DetectionProb"),.ina_slice_node(ManageProb,tt,n,T,"ManageProb"),.ina_slice_node(MortalityProb,tt,n,T,"MortalityProb"),.ina_slice_node(SpreadReduction,tt,n,T,"SpreadReduction"),SEAM,.ina_slice_node(InfoRetentionProb,tt,n,T,"InfoRetentionProb"),.ina_slice_node(FecundityReduction,tt,n,T,"FecundityReduction"))
+  } else if (Model=="INApestMetaTransitionMatrix") {
+    if(is.null(Transition)) stop("Transition ObservationHistory requires Transition"); if(is.null(Nstages)) Nstages<-nrow(as.matrix(Transition)); S<-as.integer(Nstages); if(is.null(K))K<-1;if(is.null(SeedbankK))SeedbankK<-K
+    for(tt in seq_len(T)){Ft<-.ina_slice_fecundity_transition(FecundityReduction,tt,n,S,T,"FecundityReduction");steps[[tt]]<-.ina_transition_branch_step(Transition,S,.ina_slice_connection(SDDprob,tt,n,T,"SDDprob"),.ina_slice_connection(LDDprob,tt,n,T,"LDDprob"),LDDrate,.ina_slice_node(EnvEstabProb,tt,n,T,"EnvEstabProb"),.ina_slice_node(PropaguleEstablishment,tt,n,T,"PropaguleEstablishment"),.ina_slice_stage(DetectionProb,tt,n,S,T,"DetectionProb"),.ina_slice_node(ManageProb,tt,n,T,"ManageProb"),.ina_slice_stage(MortalityProb,tt,n,S,T,"MortalityProb"),.ina_slice_node(SpreadReduction,tt,n,T,"SpreadReduction"),SEAM,.ina_slice_node(InfoRetentionProb,tt,n,T,"InfoRetentionProb"),DispersalDensityFactor,.ina_slice_node(K,tt,n,T,"K"),.ina_slice_node(SeedbankK,tt,n,T,"SeedbankK"),Ft)}
+  } else stop("Unsupported standard ObservationHistory model")
+  list(T=T,n=n,S=Nstages,mode=mode,steps=steps,InitialState=InitialState,InitialInfo=InitialInfo,ApplyInitialDetection=ApplyInitialDetection,DetectionProb=DetectionProb)
+}
+
+.ina_obshist_standard <- function(args, Model, mask) {
+  z <- .ina_obshist_standard_steps(args,Model)
+  if(Model=="INApest") {qC<-.ina_binary_observation_horizon(z$steps,z$mode,mask,"any");qJ<-.ina_binary_observation_horizon(z$steps,z$mode,mask,"extinct")} else {qC<-.ina_branch_observation_horizon(z$steps,z$mode,mask,"any");qJ<-.ina_branch_observation_horizon(z$steps,z$mode,mask,"extinct")}
+  combine <- function(q){if(z$mode=="dynamic") .ina_dynamic_initial_extinction(q,Model,z$T,z$InitialState,z$InitialInfo,z$ApplyInitialDetection,z$DetectionProb,z$n,z$S) else .ina_overall_extinction(q,.ina_dynamic_pgf_initial(Model,z$mode,z$T,z$InitialState,z$InitialInfo,z$ApplyInitialDetection,z$DetectionProb,z$n,z$S))}
+  c(P=combine(qC),Joint=combine(qJ))
+}
+
+.ina_obshist_mlu <- function(args, mask) {
+  T<-as.integer(.ina_obshist_get(args,"Ntimesteps",10)); X0<-as.matrix(.ina_obshist_get(args,"InitialState",required=TRUE)); n<-nrow(X0); L<-ncol(X0); SDDprob<-.ina_obshist_get(args,"SDDprob",required=TRUE); LDDprob<-.ina_obshist_get(args,"LDDprob",0); LDDrate<-.ina_obshist_get(args,"LDDrate",0); DetectionProb<-.ina_obshist_get(args,"DetectionProb",0); InitialInfo<-.ina_obshist_get(args,"InitialInfo",0); ApplyInitialDetection<-isTRUE(.ina_obshist_get(args,"ApplyInitialDetection",TRUE)); InfoPersistenceSteps<-.ina_obshist_get(args,"InfoPersistenceSteps",NA); if(any(!is.na(as.numeric(InfoPersistenceSteps))))stop("ObservationHistory is not yet implemented with programmed InfoPersistenceSteps")
+  mode<-.ina_info_mode(.ina_obshist_get(args,"InformationMode","auto"),.ina_obshist_get(args,"ManageProb",0),InitialInfo,DetectionProb,.ina_obshist_get(args,"SEAM",NULL),.ina_obshist_get(args,"InfoRetentionProb",1),InfoPersistenceSteps); steps<-vector("list",T)
+  K<-.ina_obshist_get(args,"K",required=TRUE); PP<-.ina_obshist_get(args,"PropaguleProduction",required=TRUE)
+  for(tt in seq_len(T)) steps[[tt]]<-.ina_mlu_branch_step(.ina_slice_connection(SDDprob,tt,n,T,"SDDprob"),.ina_slice_connection(LDDprob,tt,n,T,"LDDprob"),LDDrate,.ina_slice_node(.ina_obshist_get(args,"EnvEstabProb",1),tt,n,T,"EnvEstabProb"),.ina_slice_node(.ina_obshist_get(args,"Survival",1),tt,n,T,"Survival"),.ina_slice_K_mlu(K,tt,n,L,T),.ina_slice_node(PP,tt,n,T,"PropaguleProduction"),.ina_slice_node(.ina_obshist_get(args,"PropaguleEstablishment",1),tt,n,T,"PropaguleEstablishment"),.ina_slice_mlu(DetectionProb,tt,n,L,T,"DetectionProb"),.ina_slice_mlu(.ina_obshist_get(args,"ManageProb",0),tt,n,L,T,"ManageProb"),.ina_slice_mlu(.ina_obshist_get(args,"MortalityProb",0),tt,n,L,T,"MortalityProb"),.ina_slice_mlu(.ina_obshist_get(args,"SpreadReduction",0),tt,n,L,T,"SpreadReduction"),.ina_obshist_get(args,"SEAM",NULL),.ina_slice_node(.ina_obshist_get(args,"InfoRetentionProb",1),tt,n,T,"InfoRetentionProb"),.ina_slice_mlu(.ina_obshist_get(args,"FecundityReduction",0),tt,n,L,T,"FecundityReduction"))
+  qC<-.ina_branch_observation_horizon(steps,mode,mask,"any");qJ<-.ina_branch_observation_horizon(steps,mode,mask,"extinct")
+  c(P=.ina_mlu_initial_extinction(qC,mode,X0,InitialInfo,ApplyInitialDetection,DetectionProb,n,L,T),Joint=.ina_mlu_initial_extinction(qJ,mode,X0,InitialInfo,ApplyInitialDetection,DetectionProb,n,L,T))
+}
