+###############################################################################
+### Observation-history extension v0.2: remaining INApest host architectures
+### Adds no-detection conditioning to Binary, Meta, MLU, Transition Matrix,
+### Vertebrate Node and Vertebrate Point. MetaPoint and PointTransitionMatrix
+### are implemented above by the validated v0.1 point-family extension.
+###############################################################################
+
+.ina_obshist_get <- function(args, name, default=NULL, required=FALSE) {
+  if (name %in% names(args)) return(args[[name]])
+  if (required) stop("ObservationHistory extension requires ", name)
+  default
+}
+
+.ina_binary_step_eval_observation <- function(step, qnext, mode, require_no_detection=FALSE) {
+  if (!isTRUE(require_no_detection)) return(.ina_binary_step_eval(step, qnext, mode))
+  n <- nrow(step$P); P <- step$P; s <- step$s; a <- step$a; e <- step$e; r <- step$r
+  d <- .ina_branch_clip(step$d)
+  if (mode != "dynamic") {
+    q <- .ina_branch_clip(qnext); qs <- (1-d)*q; out <- numeric(n)
+    for (i in seq_len(n)) {
+      off <- seq_len(n) != i
+      prod0 <- prod(1-P[i,off] + P[i,off]*qs[off])
+      f0 <- (1-s[i]) + s[i]*qs[i]*prod0
+      if (mode == "all_informed") {
+        sm <- s[i]*(1-e[i]); Pm <- P[i,off]*(1-r[i])
+        prod1 <- prod(1-Pm + Pm*qs[off])
+        f1 <- (1-sm) + sm*qs[i]*prod1
+        out[i] <- (1-a[i])*f0 + a[i]*f1
+      } else out[i] <- f0
+    }
+    return(.ina_branch_clip(out))
+  }
+  q <- .ina_branch_clip(qnext); qU <- q[seq_len(n)]; qH <- q[n+seq_len(n)]
+  ir <- step$ir; C <- step$C; outU <- outH <- numeric(n)
+  silentU <- (1-d)*qU
+  for (i in seq_len(n)) {
+    off <- seq_len(n) != i
+    prodU <- prod(1-P[i,off] + P[i,off]*silentU[off])
+    outU[i] <- (1-s[i]) + s[i]*silentU[i]*prodU
+    selfH <- (1-d[i])*((1-ir[i])*qU[i] + ir[i]*qH[i])
+    hc <- .ina_branch_clip(C[i,])
+    childH <- (1-d)*((1-hc)*qU + hc*qH)
+    prod0 <- prod(1-P[i,off] + P[i,off]*childH[off])
+    f0 <- (1-s[i]) + s[i]*selfH*prod0
+    sm <- s[i]*(1-e[i]); Pm <- P[i,off]*(1-r[i])
+    prod1 <- prod(1-Pm + Pm*childH[off])
+    f1 <- (1-sm) + sm*selfH*prod1
+    outH[i] <- (1-a[i])*f0 + a[i]*f1
+  }
+  .ina_branch_clip(c(outU,outH))
+}
+
+.ina_binary_observation_horizon <- function(steps, mode, mask, terminal=c("any","extinct")) {
+  terminal <- match.arg(terminal); n <- nrow(steps[[1]]$P)
+  q <- rep(if (terminal=="any") 1 else 0, if (mode=="dynamic") 2*n else n)
+  for (tt in rev(seq_along(steps))) q <- .ina_binary_step_eval_observation(steps[[tt]],q,mode,mask[tt])
+  q
+}
