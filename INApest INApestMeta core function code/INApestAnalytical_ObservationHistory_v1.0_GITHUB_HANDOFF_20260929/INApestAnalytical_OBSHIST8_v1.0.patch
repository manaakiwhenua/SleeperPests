+###############################################################################
+### Observation-history conditioning extension (29-Sep-2026)
+###
+### Adds finite-horizon conditioning on timesteps at which NO detection is
+### allowed.  This is designed for histories such as post-cutoff surveillance
+### silence.  The event is evaluated by the same one-parent branching PGF used
+### for extinction, with detection branches removed only at constrained steps.
+###
+### ObservationHistory accepted forms:
+###   * logical vector length Ntimesteps: TRUE = require no detection;
+###   * list(NoDetection = logical vector length Ntimesteps);
+###   * data.frame with columns timestep and observation, where observation is
+###     one of "none" / "no_detection" / "silence" / "unconstrained" / "any".
+###
+### Current scope deliberately supports no-detection constraints only.  A
+### positive-detection requirement is not the complement at an intermediate
+### timestep when later information-dependent management is present, and should
+### therefore be added as an explicit state/event extension rather than by
+### subtraction.
+###############################################################################
+
+.ina_observation_history_mask <- function(ObservationHistory, Ntimesteps) {
+  if (is.null(ObservationHistory)) return(NULL)
+  T <- as.integer(Ntimesteps)
+  if (length(T) != 1L || !is.finite(T) || T < 1L)
+    stop("Ntimesteps must be a positive integer")
+
+  if (is.logical(ObservationHistory)) {
+    if (length(ObservationHistory) != T)
+      stop("Logical ObservationHistory must have length Ntimesteps")
+    if (anyNA(ObservationHistory))
+      stop("Logical ObservationHistory cannot contain NA")
+    return(as.logical(ObservationHistory))
+  }
+
+  if (is.list(ObservationHistory) && !is.data.frame(ObservationHistory)) {
+    if (is.null(ObservationHistory$NoDetection))
+      stop("List ObservationHistory currently requires a NoDetection element")
+    x <- ObservationHistory$NoDetection
+    if (!is.logical(x) || length(x) != T || anyNA(x))
+      stop("ObservationHistory$NoDetection must be a non-NA logical vector of length Ntimesteps")
+    return(as.logical(x))
+  }
+
+  if (is.data.frame(ObservationHistory)) {
+    if (!all(c("timestep", "observation") %in% names(ObservationHistory)))
+      stop("Data-frame ObservationHistory requires timestep and observation columns")
+    mask <- rep(FALSE, T)
+    tt <- as.integer(ObservationHistory$timestep)
+    if (anyNA(tt) || any(tt < 1L | tt > T))
+      stop("ObservationHistory$timestep values must be within 1:Ntimesteps")
+    obs <- tolower(trimws(as.character(ObservationHistory$observation)))
+    no <- obs %in% c("none", "no_detection", "no detection", "silence", "silent", "zero")
+    anyok <- obs %in% c("unconstrained", "any", "ignore", "*")
+    if (any(!(no | anyok)))
+      stop("ObservationHistory currently supports only no-detection or unconstrained observations")
+    for (k in seq_along(tt)) mask[tt[k]] <- no[k]
+    return(mask)
+  }
+
+  stop("Unsupported ObservationHistory format")
+}
