+INApestAnalytical_pre_obshist8 <- INApestAnalytical
+INApestAnalytical <- function(...) {
+  args<-list(...); oh<-args$ObservationHistory
+  if(is.null(oh)) return(do.call(INApestAnalytical_pre_obshist8,args))
+  Model<-if(!is.null(args$Model))as.character(args$Model)[1L]else"INApest";T<-as.integer(.ina_obshist_get(args,"Ntimesteps",10));mask<-.ina_observation_history_mask(oh,T)
+  if(Model %in% c("INApestMetaPoint","INApestPointTransitionMatrix")) return(do.call(INApestAnalytical_pre_obshist8,args))
+  args0<-args;args0$ObservationHistory<-NULL;res<-do.call(INApestAnalytical_pre_obshist8,args0)
+  pj<-if(Model %in% c("INApest","INApestMeta","INApestMetaTransitionMatrix")) .ina_obshist_standard(args,Model,mask) else if(Model=="INApestMetaMultipleLandUse") .ina_obshist_mlu(args,mask) else if(Model %in% c("INApestVertebrateNode","INApestVertebratePoint")) .ina_obshist_vertebrate(args,Model,mask) else stop("ObservationHistory unsupported for Model=",Model)
+  pC<-unname(pj["P"]);pJ<-unname(pj["Joint"]);res$ObservationHistory<-list(NoDetectionByTimestep=mask,Probability=pC,ExtinctionJointProbability=pJ,ExtinctionConditionalProbability=if(pC>0)pJ/pC else NA_real_,Method="finite-horizon no-detection conditioning on the architecture-specific branching PGF",Diagnostics=if(Model %in% c("INApestVertebrateNode","INApestVertebratePoint"))"Vertebrate detection is observation-only in this analytical layer; response ManagementExposure remains externally specified, matching the host vertebrate analytical approximation." else NULL)
+  res
+}
+
+# MLU exact one-parent observation evaluator: preserve integer count PGF while
+# deleting all branches containing a detection at constrained timesteps.
+.ina_branch_step_eval_observation_pre_mlu_obshist <- .ina_branch_step_eval_observation
+.ina_branch_step_eval_observation <- function(step,qnext,mode=c('none','all_informed','dynamic'),require_no_detection=FALSE){
+  mode<-match.arg(mode)
+  if(identical(step$EvaluatorType,'MLUExact') && isTRUE(require_no_detection)){
+    B<-step$B;D<-as.numeric(step$Detection);if(length(D)==1L)D<-rep(D,B)
+    z<-step;z$Detection[]<-0;z$DetectionMatrix[,]<-0
+    q<-as.numeric(qnext)
+    if(mode=='dynamic') q<-c((1-D)*q[seq_len(B)],(1-D)*q[B+seq_len(B)]) else q<-(1-D)*q
+    return(.ina_mlu_branch_step_eval(z,q,mode))
+  }
+  .ina_branch_step_eval_observation_pre_mlu_obshist(step,qnext,mode,require_no_detection)
+}
+
+# Final NULL-parity wrapper correction: do not forward an explicit NULL
+# ObservationHistory through legacy ... dispatchers that reject unknown args.
+INApestAnalytical_pre_obshist8_nullfix <- INApestAnalytical
+INApestAnalytical <- function(...) {
+  args <- list(...)
+  if ('ObservationHistory' %in% names(args) && is.null(args$ObservationHistory)) {
+    args$ObservationHistory <- NULL
+    # invoke the pre-observation dispatcher, not the observation wrapper
+    return(do.call(INApestAnalytical_pre_obshist8, args))
+  }
+  do.call(INApestAnalytical_pre_obshist8_nullfix, args)
+}
